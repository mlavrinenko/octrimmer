{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "octrimmer",
    "version": "0.1.0",
    "type": "module",
    "description": "Manual context trimmer for OpenCode. Cut from a start point; keep prior content verbatim by reference — never re-generate it.",
    "main": "./dist/index.js",
    "exports": {
        ".": {
            "import": "./dist/index.js"
        }
    },
    "keywords": [
        "opencode",
        "opencode-plugin",
        "plugin",
        "context",
        "trim",
        "compaction",
        "tokens"
    ],
    "peerDependencies": {
        "@opencode-ai/plugin": ">=1.4.3"
    },
    "devDependencies": {
        "@opencode-ai/plugin": "^1.4.3",
        "@types/node": "^25.5.0",
        "knip": "^6.39.0",
        "oxlint": "^1.60.0",
        "prettier": "^3.8.1",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.2",
        "vitest": "^3.0.0"
    },
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ],
    "license": "MIT"
}
